# Copy to .env.local and fill in from your EmailJS dashboard (https://dashboard.emailjs.com).
# Without these the contact form will fail on submit and show an error toast.
# NEXT_PUBLIC_* values are exposed to the browser by design — EmailJS public keys are safe to ship.

NEXT_PUBLIC_EMAILJS_SERVICE=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_USER=your_public_key

# reCAPTCHA v2 ("I'm not a robot") site key from https://google.com/recaptcha/admin
# Only the SITE key belongs here. The SECRET key goes in the EmailJS template
# (Email Templates -> your template -> Settings -> Enable reCAPTCHA V2) and must
# never appear in this repo.
# Leave unset to run the form without a captcha during local development.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
